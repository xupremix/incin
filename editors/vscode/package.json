{
  "name": "incin-lsp-vscode",
  "displayName": "Incin Shape Diagnostics",
  "description": "Humanizes typenum shape errors and shows real tensor shapes as inlay hints, by routing rust-analyzer through the incin-lsp proxy.",
  "version": "0.1.0-rc.2",
  "publisher": "incin",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xupremix/incin.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "extensionDependencies": [
    "rust-lang.rust-analyzer"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "workspaceContains:Cargo.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "incin.toggleShapeHints",
        "title": "Incin: Toggle Shape Hints"
      }
    ],
    "configuration": {
      "title": "Incin",
      "properties": {
        "incin.lspPath": {
          "type": "string",
          "default": "incin-lsp",
          "description": "Path to the incin-lsp binary (resolved via PATH if not absolute)."
        },
        "incin.shortenBackend": {
          "type": "boolean",
          "default": false,
          "description": "Drop the backend/dtype/grad tail from a rewritten inlay hint (Tensor<[2, 3]> instead of Tensor<[2, 3], CpuBackendImpl<f32, Cpu>>)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.0.0",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "diff": "8.0.3",
    "js-yaml": "4.3.1",
    "serialize-javascript": "7.0.5"
  }
}
