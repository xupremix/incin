{
  "name": "kindle-lsp-vscode",
  "displayName": "Kindle Shape Diagnostics",
  "description": "Humanizes typenum shape errors and shows real tensor shapes as inlay hints, by routing rust-analyzer through the kindle-lsp proxy.",
  "version": "0.1.0",
  "publisher": "kindle",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "extensionDependencies": [
    "rust-lang.rust-analyzer"
  ],
  "activationEvents": [
    "workspaceContains:**/Cargo.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kindle.toggleShapeHints",
        "title": "Kindle: Toggle Shape Hints"
      }
    ],
    "configuration": {
      "title": "Kindle",
      "properties": {
        "kindle.lspPath": {
          "type": "string",
          "default": "kindle-lsp",
          "description": "Path to the kindle-lsp binary (resolved via PATH if not absolute)."
        },
        "kindle.shortenBackend": {
          "type": "boolean",
          "default": false,
          "description": "Drop the backend/dtype/grad tail from a rewritten inlay hint (Tensor<[2, 3]> instead of Tensor<[2, 3], CpuBackendImpl<f32, Cpu>>)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.0.0",
    "mocha": "^11.7.6",
    "typescript": "^5.4.0"
  }
}
