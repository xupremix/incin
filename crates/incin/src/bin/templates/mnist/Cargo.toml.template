[package]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
edition = "2024"

[dependencies]
# Version dependencies, so this scaffold builds anywhere rather than only on
# the machine that generated it. Both crates are published; the version is the
# one the `cargo incin new` that wrote this file was built from, so a scaffold
# always matches the tool that produced it.
incin = { version = "{{INCIN_VERSION}}", default-features = false, features = ["std", "cpu"] }
incin-telemetry = "{{INCIN_VERSION}}"
